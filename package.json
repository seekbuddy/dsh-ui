{
  "name": "@seekbuddy/dsh-ui",
  "version": "0.2.0",
  "description": "Unofficial React components in the DeepSeek Harness (DSH) web UI design system: the DSH primitives plus the components DSH does not provide (cards, tabs, pagination, messages, upload, date/time pickers), on the same --dsw-* tokens. Not affiliated with or endorsed by DeepSeek.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "react",
    "ui",
    "design-system",
    "tokens"
  ],
  "homepage": "https://github.com/seekbuddy/dsh-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seekbuddy/dsh-ui.git"
  },
  "bugs": {
    "url": "https://github.com/seekbuddy/dsh-ui/issues"
  },
  "author": "SeekBuddy",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/types/blocks.d.ts",
      "import": "./dist/blocks.js"
    },
    "./markdown": {
      "types": "./dist/types/markdown.d.ts",
      "import": "./dist/markdown.js"
    },
    "./icons": {
      "types": "./dist/types/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./theme": {
      "types": "./dist/types/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./theme/bootstrap": {
      "types": "./dist/types/theme-bootstrap.d.ts",
      "import": "./dist/theme-bootstrap.js"
    },
    "./seekbuddy": {
      "types": "./dist/types/seekbuddy/index.d.ts",
      "import": "./dist/seekbuddy.js"
    },
    "./seekbuddy/card": {
      "types": "./dist/types/seekbuddy/Card.d.ts",
      "import": "./dist/seekbuddy-card.js"
    },
    "./seekbuddy/empty": {
      "types": "./dist/types/seekbuddy/Empty.d.ts",
      "import": "./dist/seekbuddy-empty.js"
    },
    "./seekbuddy/spinner": {
      "types": "./dist/types/seekbuddy/Spinner.d.ts",
      "import": "./dist/seekbuddy-spinner.js"
    },
    "./seekbuddy/tabs": {
      "types": "./dist/types/seekbuddy/Tabs.d.ts",
      "import": "./dist/seekbuddy-tabs.js"
    },
    "./seekbuddy/timeline": {
      "types": "./dist/types/seekbuddy/Timeline.d.ts",
      "import": "./dist/seekbuddy-timeline.js"
    },
    "./tokens.css": {
      "types": "./dist/tokens.css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./katex.css": {
      "types": "./dist/katex.css.d.ts",
      "default": "./dist/katex.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.mjs"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node build/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:react18": "node scripts/test-fixture.mjs react18",
    "test:next16": "node scripts/test-fixture.mjs next16",
    "verify": "npm run typecheck && npm run test:docs && npm run test:unit && npm run build && npm run test:package && npm run test:react18 && npm run test:next16",
    "prepack": "npm run build",
    "test:docs": "node scripts/check-doc-pairs.mjs && node scripts/check-doc-examples.mjs"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-code-language": "0.2.0-rc.2",
    "@shikijs/langs": "^4.3.1",
    "@types/mdast": "^4.0.4",
    "anser": "^2.3.5",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "katex": "^0.16.47",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.0.1",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "shiki": "^4.3.1",
    "simple-icons": "16.31.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "esbuild": "^0.25.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "publishConfig": {
    "access": "public"
  }
}
