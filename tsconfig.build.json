{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@seekbuddy/dsh-ui": ["./src/index.ts"],
      "@seekbuddy/dsh-ui/blocks": ["./src/blocks.ts"],
      "@seekbuddy/dsh-ui/markdown": ["./src/markdown.ts"],
      "@seekbuddy/dsh-ui/icons": ["./src/icons.ts"],
      "@seekbuddy/dsh-ui/theme": ["./src/theme.ts"],
      "@seekbuddy/dsh-ui/theme/bootstrap": ["./src/theme-bootstrap.ts"]
    },
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "rootDir": "src"
  },
  "include": ["src"]
}
